# EmailJS: envia as mensagens do formulário de contacto (opcional).
# Sem estas chaves, o formulário abre a aplicação de email do visitante com a mensagem escrita.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Assistente (chat): endereço do backend que responde às mensagens, por exemplo /api/assistant.
# Em `npm run dev` o chat usa respostas de demonstração; no site publicado só aparece com este endereço.
VITE_ASSISTANT_URL=
